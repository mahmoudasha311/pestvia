# Atlas connection string, including the database name. Server-side only.
MONGODB_URI=

# Private Telegram bot. Missing credentials never prevent saving a lead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional extra protection for hashed rate-limit keys. Keep stable across instances.
RATE_LIMIT_SALT=

# Vercel provides trusted client IP headers. For another host, configure its
# trusted, overwritten proxy header; never trust a user-controlled forwarding chain.
TRUSTED_CLIENT_IP_HEADER=

# Production approval: review CONTENT_TODO.md before setting true.
# VERCEL_ENV is provided by Vercel. DEPLOYMENT_ENV is the non-Vercel fallback.
CONTENT_APPROVED=false
DEPLOYMENT_ENV=development

# Optional verification; blank omits the metadata tag.
GOOGLE_SITE_VERIFICATION=
# Reserved only. No analytics script is loaded.
NEXT_PUBLIC_ANALYTICS_ID=

# Reserved for a future storage provider. No provider is integrated.
STORAGE_PROVIDER=
STORAGE_ACCOUNT=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# Optional isolated MongoDB database for integration tests only.
MONGODB_TEST_URI=
