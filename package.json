{
  "name": "pestvia",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-content-approval.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --conditions=react-server --import ./scripts/register-test-loader.mjs --test tests/*.test.ts",
    "db:indexes": "node --conditions=react-server --import ./scripts/register-typescript.mjs scripts/db-indexes.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lucide-react": "^1.52.0",
    "mongoose": "9.10.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
